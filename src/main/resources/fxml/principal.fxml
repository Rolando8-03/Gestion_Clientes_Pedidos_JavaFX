<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.uam.gestion.controller.PrincipalController">
    <top>
        <VBox styleClass="cabecera" spacing="5">
            <Label text="Gestión de clientes y pedidos" styleClass="titulo"/>
            <Label text="Programación de Aplicaciones de Escritorio · UAM" styleClass="subtitulo"/>
        </VBox>
    </top>
    <center>
        <VBox fx:id="contenidoBox">
            <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <tabs>
                    <Tab text="Clientes">
                        <VBox spacing="14" styleClass="contenido">
                            <VBox spacing="10" styleClass="tarjeta">
                                <Label fx:id="clienteEdicionLabel" text="Nuevo cliente" styleClass="seccion"/>
                                <HBox spacing="14">
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label text="Nombre completo" labelFor="$nombreField"/>
                                        <TextField fx:id="nombreField" promptText="Ej.: Ana Pérez"/>
                                    </VBox>
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label text="Correo electrónico" labelFor="$correoField"/>
                                        <TextField fx:id="correoField" promptText="Ej.: ana@correo.com"/>
                                    </VBox>
                                </HBox>
                                <HBox spacing="8">
                                    <Button fx:id="guardarClienteBtn" text="Registrar cliente" onAction="#guardarCliente" styleClass="primario"/>
                                    <Button fx:id="actualizarClienteBtn" text="Actualizar" onAction="#editarCliente"/>
                                    <Button fx:id="eliminarClienteBtn" text="Eliminar" onAction="#eliminarCliente" styleClass="peligro"/>
                                    <Button fx:id="limpiarClienteBtn" text="Limpiar" onAction="#limpiarCliente"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Recargar" onAction="#actualizarTablas"/>
                                </HBox>
                            </VBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <TextField fx:id="buscarClienteField" promptText="Buscar por nombre o correo" onAction="#buscarClientes" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="buscarClientesBtn" text="Buscar" onAction="#buscarClientes"/>
                                <Button text="Ver todos" onAction="#quitarFiltroClientes"/>
                            </HBox>
                            <TableView fx:id="clientesTabla" VBox.vgrow="ALWAYS">
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                                <placeholder><Label text="No hay clientes para mostrar. Registre uno o cambie la búsqueda."/></placeholder>
                                <columns>
                                    <TableColumn fx:id="idClienteCol" text="ID" prefWidth="70" maxWidth="100"/>
                                    <TableColumn fx:id="nombreCol" text="Nombre completo" prefWidth="400"/>
                                    <TableColumn fx:id="correoCol" text="Correo electrónico" prefWidth="430"/>
                                </columns>
                            </TableView>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label fx:id="clientesResumenLabel" text="0 cliente(s)" styleClass="resumen"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Seleccione una fila para editar o eliminar." styleClass="ayuda"/>
                            </HBox>
                        </VBox>
                    </Tab>
                    <Tab text="Pedidos y reportes">
                        <VBox spacing="14" styleClass="contenido">
                            <VBox spacing="10" styleClass="tarjeta">
                                <Label fx:id="pedidoEdicionLabel" text="Nuevo pedido" styleClass="seccion"/>
                                <HBox spacing="14">
                                    <VBox spacing="5" prefWidth="250">
                                        <Label text="Cliente" labelFor="$clienteCombo"/>
                                        <ComboBox fx:id="clienteCombo" promptText="Seleccione un cliente" maxWidth="Infinity"/>
                                    </VBox>
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label text="Descripción" labelFor="$descripcionField"/>
                                        <TextField fx:id="descripcionField" promptText="Detalle del pedido"/>
                                    </VBox>
                                    <VBox spacing="5" prefWidth="160">
                                        <Label text="Monto (C$)" labelFor="$montoField"/>
                                        <TextField fx:id="montoField" promptText="0.00"/>
                                    </VBox>
                                </HBox>
                                <HBox spacing="8">
                                    <Button fx:id="crearPedidoBtn" text="Registrar pedido" onAction="#crearPedido" styleClass="primario"/>
                                    <Button fx:id="actualizarPedidoBtn" text="Actualizar" onAction="#editarPedido"/>
                                    <Button fx:id="eliminarPedidoBtn" text="Eliminar" onAction="#eliminarPedido" styleClass="peligro"/>
                                    <Button fx:id="limpiarPedidoBtn" text="Limpiar" onAction="#limpiarPedido"/>
                                </HBox>
                            </VBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <ComboBox fx:id="filtroClienteCombo" promptText="Todos los clientes" prefWidth="250"/>
                                <TextField fx:id="buscarPedidoField" promptText="Buscar por descripción" onAction="#filtrarPedidos" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="filtrarPedidosBtn" text="Aplicar filtro" onAction="#filtrarPedidos"/>
                                <Button fx:id="quitarFiltroBtn" text="Ver todos" onAction="#quitarFiltroPedidos"/>
                            </HBox>
                            <TableView fx:id="pedidosTabla" VBox.vgrow="ALWAYS">
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                                <placeholder><Label text="No hay pedidos para mostrar. Registre uno o cambie los filtros."/></placeholder>
                                <columns>
                                    <TableColumn fx:id="idPedidoCol" text="ID" prefWidth="60" maxWidth="80"/>
                                    <TableColumn fx:id="pedidoClienteCol" text="Cliente" prefWidth="220"/>
                                    <TableColumn fx:id="descripcionCol" text="Descripción" prefWidth="370"/>
                                    <TableColumn fx:id="totalCol" text="Total (C$)" prefWidth="140"/>
                                    <TableColumn fx:id="fechaCol" text="Fecha" prefWidth="130"/>
                                </columns>
                            </TableView>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label fx:id="pedidosResumenLabel" text="0 pedido(s)" styleClass="resumen"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="reporteBtn" text="Generar reporte PDF" onAction="#generarReporte" styleClass="primario"/>
                            </HBox>
                            <Label text="El PDF incluye los pedidos mostrados en la tabla. Al exportar se reemplaza reportes/pedidos.pdf." styleClass="ayuda"/>
                        </VBox>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </center>
    <bottom>
        <HBox styleClass="barra-estado" spacing="10" alignment="CENTER_LEFT">
            <ProgressIndicator fx:id="progreso" prefWidth="20" prefHeight="20" visible="false" managed="false"/>
            <Label fx:id="estadoLabel" text="Cargando información..." wrapText="true"/>
        </HBox>
    </bottom>
</BorderPane>
